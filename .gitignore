# Large data files (use GitHub Releases)
*.duckdb
*.duckdb.wal

# Model files. Trained models are published to GitHub Releases via piggyback,
# never committed -- see bouncerverse/CLAUDE.md. The previous patterns matched
# only files directly in models/, so subdirectories (e.g. dated backups taken
# before a retrain) showed up as untracked. Nothing under models/ has ever been
# tracked, so ignoring the whole directory is safe and matches the intent.
models/

# Scraped data
fox_cricket/
cricinfo/

# Raw JSON data (can be re-downloaded from Cricsheet)
json_files/

# R artifacts
.Rhistory
.Rdata
.RData
*.Rproj.user

# Claude Code
.claude/
tmpclaude-*
.Rproj.user

# Internal setup docs (not for repo)
*_SETUP.md
*_NOTES.md

# SSH keys and secrets (never commit!)
*.key
*.pem
ssh-key*
*.github_pat
.env
.secrets

# FOX Sports discovery cache
fox_discovered_*.rds

# Log files and temp artifacts
*.log
*_log.txt
*_log*.txt
temp_*/
*.duckdb.wal.backup

# Cricinfo consolidation reports (scraper run output, regenerable)
cricinfo_consolidation_report_*.json

# One-off series discovery outputs
scripts/series_list_*.csv
!scripts/series_list.csv

# Python
__pycache__/
*.pyc

# RStudio project file
*.Rproj

# Archived files (obsolete VM scripts, etc.)
archive/

# Cloudflare Wrangler cache
.wrangler/

# Blog data build artifacts (regenerable via build-blog-data workflow)
blog/
source/

# Local dry-run output from scripts/consolidate_cricinfo_assets.py
cricinfo_consolidation_report_*.json

# Weather cache: parquet fetched from Open-Meteo via the wheather package
# (bouncerverse#72). Data, not code -- it belongs in a release, not in git, the
# same as models/. Regenerable by re-running the fetch, and free to re-run
# because the cache is checked before any API call.
weather-cache/
